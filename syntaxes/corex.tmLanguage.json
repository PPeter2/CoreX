{
  "$schema": "https://githubusercontent.com",
  "name": "CoreX",
  "scopeName": "source.cx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#function-declarations" },
    { "include": "#type-declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rust",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rust",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rust",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.rust entity.name.type.attribute.rust",
          "match": "#\\[[a-zA-Z_][a-zA-Z0-9_]*\\]"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(func|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.rust" },
            "2": { "name": "entity.name.function.rust" }
          }
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(struct|enum|type|trait|impl)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.rust" },
            "2": { "name": "entity.name.type.struct.rust" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rust",
          "match": "\\b(if|else|match|while|for|in|loop|return|break|continue|defer)\\b"
        },
        {
          "name": "keyword.other.rust",
          "match": "\\b(func|fn|let|mut|const|static|struct|enum|type|impl|trait|pub|extern|using|import|use)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.rust",
          "match": "\\b(int|string|char|bool|void|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rust",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.rust",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.rust",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rust",
          "match": "(\\+|\\-|\\*|/|%|=|==|!=|<|>|<=|>=|&&|\\|\\||!|&|\\||->|\\*const|\\*mut)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.brackets.rust",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        },
        {
          "name": "punctuation.separator.rust",
          "match": "[,;:]"
        }
      ]
    }
  }
}
